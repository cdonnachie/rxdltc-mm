# Copy to .env and fill in. NEVER commit .env.
#
# KDF / mm2 RPC endpoint. Keep KDF bound to 127.0.0.1 (see README "Security").
KDF_RPC_URL=http://127.0.0.1:7783
# The "rpc_password" from your MM2.json. Required.
KDF_RPC_PASSWORD=change-me

# Path to the bot config (YAML). Optional, defaults to ./config.yaml
MM_BOT_CONFIG=config.yaml

# Live trading requires BOTH `dry_run: false` in the config AND this variable.
# Leave it unset for dry-run. Set exactly to: I_UNDERSTAND_THIS_TRADES_REAL_FUNDS
#MM_BOT_CONFIRM_LIVE=

# Optional price provider API keys (public endpoints work without them).
#COINGECKO_API_KEY=
#COINPAPRIKA_API_KEY=

# Optional overrides
#MM_BOT_LOG_LEVEL=DEBUG
#MM_BOT_DATA_DIR=./data
