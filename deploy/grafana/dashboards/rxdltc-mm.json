{
  "uid": "rxdltc-mm",
  "title": "RXD/LTC liquidity bot",
  "tags": [
    "rxdltc-mm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "State",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_state == 1",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Paused",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_paused",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "quoting",
                  "color": "green"
                },
                "1": {
                  "text": "PAUSED",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Mode",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_dry_run",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "LIVE",
                  "color": "red"
                },
                "1": {
                  "text": "dry run",
                  "color": "blue"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Open orders",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_open_order",
          "legendFormat": "{{side}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "orange"
                },
                "1": {
                  "text": "open",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_uptime_seconds",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Quotes and fair value (USD per RXD)",
      "description": "The dollar price of one RXD. The bid is what the bot pays, the ask what it asks. Internally these are RXD per LTC, where the ordering looks inverted.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_fair_price_usd_per_rxd",
          "legendFormat": "fair"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_target_bid_usd_per_rxd",
          "legendFormat": "bid (bot buys)"
        },
        {
          "refId": "C",
          "expr": "rxdltc_mm_target_ask_usd_per_rxd",
          "legendFormat": "ask (bot sells)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 8,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Price sources (USD per RXD)",
      "description": "Each source's own RXD price. Divergence here is what trips the disagreement breaker.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_provider_rxd_usd",
          "legendFormat": "{{provider}}"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_reference_disagreement_pct",
          "legendFormat": "disagreement %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 8,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "disagreement %"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Inventory",
      "description": "Share of wallet value held as RXD. The bot stops bidding above the max and stops asking below the min.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_inventory_rxd_value_pct",
          "legendFormat": "RXD share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 25
              },
              {
                "color": "orange",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Balances (USD)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_balance_rxd_usd",
          "legendFormat": "RXD"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_balance_ltc_usd",
          "legendFormat": "LTC"
        },
        {
          "refId": "C",
          "expr": "rxdltc_mm_portfolio_usd",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    8,
                    4
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "description": "Both holdings valued in dollars, so the split is directly comparable."
    },
    {
      "type": "timeseries",
      "title": "Trading and errors",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_swaps_total",
          "legendFormat": "swaps"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_swaps_failed_total",
          "legendFormat": "failed swaps"
        },
        {
          "refId": "C",
          "expr": "rxdltc_mm_rpc_failures_total",
          "legendFormat": "RPC failures"
        },
        {
          "refId": "D",
          "expr": "rxdltc_mm_order_errors_total",
          "legendFormat": "order errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "drawStyle": "line"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Two-sided liquidity provided",
      "description": "Cumulative seconds with a live quote on both sides, across all runs.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_two_sided_seconds_total",
          "legendFormat": "two-sided"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Provider health",
      "description": "1 healthy, 0 failing. A source dropping out is usually rate limiting or an API change.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_provider_healthy",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Wallet value",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_portfolio_usd",
          "instant": true
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Balances (coins)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_balance_rxd",
          "legendFormat": "RXD"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_balance_ltc",
          "legendFormat": "LTC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LTC"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Reference rates",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rxdltc-prometheus"
      },
      "description": "The median USD prices the bot values everything with.",
      "targets": [
        {
          "refId": "A",
          "expr": "rxdltc_mm_rxd_usd",
          "legendFormat": "RXD"
        },
        {
          "refId": "B",
          "expr": "rxdltc_mm_ltc_usd",
          "legendFormat": "LTC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RXD"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 8
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LTC"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      }
    }
  ]
}
